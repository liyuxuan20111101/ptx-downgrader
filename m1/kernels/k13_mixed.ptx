.version 8.0
.target sm_90
.address_size 64

// "CUDA 13 风格"输入:故意包含全部待降级写法——
//   1) 特殊寄存器 %tid.x 直接做 add 操作数(ISA 8.x 允许,7.0 不允许)
//   2) mov.f16 带立即数
//   3) dp4a.lo.s32.s32(多出的 .lo)
//   4) ld.global.L1::evict_first(ISA 7.4+ 缓存提示)
.visible .entry mixed(
    .param .u64 src16,
    .param .u64 dst16,
    .param .u64 src8,
    .param .u64 dst8,
    .param .u32 n)
{
    .reg .f16   %h<8>;
    .reg .pred  %p<2>;
    .reg .b32   %r<12>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [src16];
    ld.param.u64    %rd2, [dst16];
    ld.param.u64    %rd3, [src8];
    ld.param.u64    %rd4, [dst8];
    ld.param.u32    %r1, [n];

    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mul.lo.u32      %r4, %r2, %r3;
    add.u32         %r4, %r4, %tid.x;
    setp.ge.u32     %p1, %r4, %r1;
    @%p1 bra        DONE;

    // fp16:half2 缩放,lo*2.0 / hi*1.0,ld 带新缓存提示
    mul.wide.u32    %rd5, %r4, 4;
    add.s64         %rd6, %rd1, %rd5;
    add.s64         %rd7, %rd2, %rd5;
    ld.global.L1::evict_first.b32 %r5, [%rd6];
    mov.b32         {%h1, %h2}, %r5;
    mov.f16         %h3, 0x4000;
    mov.f16         %h4, 0x3C00;
    mul.rn.f16      %h5, %h1, %h3;
    mul.rn.f16      %h6, %h2, %h4;
    mov.b32         %r6, {%h5, %h6};
    st.global.b32   [%rd7], %r6;

    // int8:dp4a 点积(b 向量每字节 = 1,即求 4 字节有符号和)
    add.s64         %rd8, %rd3, %rd5;
    add.s64         %rd9, %rd4, %rd5;
    ld.global.b32   %r7, [%rd8];
    mov.b32         %r8, 0x01010101;
    mov.u32         %r9, 0;
    dp4a.lo.s32.s32 %r10, %r7, %r8, %r9;
    st.global.b32   [%rd9], %r10;

DONE:
    ret;
}
