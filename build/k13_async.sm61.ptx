.version 7.0
.target sm_61
.address_size 64
.visible .entry async_copy(.param .u64 src, .param .u64 dst, .param .u32 n_tiles) {
.reg .b32 %rdg<5>;
.reg .pred  %p<2>;
.reg .f32   %f<6>;
.reg .b32   %r<12>;
.reg .b64   %rd<12>;
.shared .align 16 .b8 tile[1024];
ld.param.u64 %rd1, [src];
ld.param.u64 %rd2, [dst];
ld.param.u32 %r1, [n_tiles];
mov.u32 %r2, %ctaid.x;
mov.u32 %r3, %ntid.x;
mul.lo.u32 %r4, %r2, %r3;
mov.u32 %rdg4, %tid.x;
add.u32 %r4, %r4, %rdg4;
setp.ge.u32 %p1, %r4, %r1;
@%p1 bra DONE;
mul.wide.u32 %rd5, %r4, 16;
mov.u32 %r5, %tid.x;
mul.wide.u32 %rd9, %r5, 16;
add.s64 %rd6, %rd1, %rd5;
mov.u64 %rd7, tile;
add.s64 %rd7, %rd7, %rd9;
ld.global.b32 %rdg0, [%rd6];
st.shared.b32 [%rd7], %rdg0;
ld.global.b32 %rdg1, [%rd6+4];
st.shared.b32 [%rd7+4], %rdg1;
mov.b32 %rdg2, 0;
st.shared.b32 [%rd7+8], %rdg2;
mov.b32 %rdg3, 0;
st.shared.b32 [%rd7+12], %rdg3;
bar.sync 0;
ld.shared.f32 %f1, [%rd7+0];
ld.shared.f32 %f2, [%rd7+4];
ld.shared.f32 %f3, [%rd7+8];
ld.shared.f32 %f4, [%rd7+12];
mul.f32 %f1, %f1, 0f40000000;
mul.f32 %f2, %f2, 0f40000000;
mul.f32 %f3, %f3, 0f40000000;
mul.f32 %f4, %f4, 0f40000000;
add.s64 %rd8, %rd2, %rd5;
st.global.f32 [%rd8+0], %f1;
st.global.f32 [%rd8+4], %f2;
st.global.f32 [%rd8+8], %f3;
st.global.f32 [%rd8+12], %f4;
DONE:
ret;
}
